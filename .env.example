# Server
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
LOG_LEVEL=info

# SQLite
DATABASE_PATH=./data/dogcast.db

# Auth
JWT_ACCESS_SECRET=dev-only-access-secret-change-me
JWT_ACCESS_TTL_SEC=900
REFRESH_TTL_SEC=1209600
COOKIE_SECURE=false
AUTH_PUBLIC_REGISTER=false
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# CORS（逗号分隔；开发期包含 Vite）
CORS_ORIGINS=http://localhost:5173

# Rate limit
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW_MS=60000
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=60000

# TURN / STUN（不要把真实长期口令写进仓库）
TURN_AUTH_SECRET=dev-only-turn-secret-change-me
TURN_URLS=turn:turn.dogleaf.cn:3478?transport=udp,turn:turn.dogleaf.cn:3478?transport=tcp
TURNS_URLS=turns:turn.dogleaf.cn:5349?transport=tcp
STUN_URLS=stun:turn.dogleaf.cn:3478
TURN_CREDENTIAL_TTL_SEC=3600

# Room defaults
DEFAULT_ROOM_SLUG=home
DEFAULT_ROOM_NAME=家庭房
MAX_VIEWERS=4

# WebSocket
WS_AUTH_TIMEOUT_MS=10000
WS_IDLE_TIMEOUT_MS=45000
